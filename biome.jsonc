{
	"$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
	"vcs": {
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!dist", "!./icons/mat_icon/index.ts"]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useTemplate": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
