	"devDependencies": {
		"@biomejs/biome": "^2.1.1",
		"@types/node": "^24.0.12",
		"lefthook": "^1.12.2",
		"publint": "^0.3.12",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"chalk": "^5.4.1",
